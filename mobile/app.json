{
  "expo": {
    "name": "Reelive",
    "slug": "reelive",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/reelive-app-icon-white.png",
    "scheme": "reelive",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.reelive.app"
    },
    "android": {
      "package": "com.reelive.app",
      "adaptiveIcon": {
        "backgroundColor": "#131110",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/reelive-splash-wortmarke.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Reelive braucht die Kamera, um deine Momente einzufangen.",
          "microphonePermission": "Reelive braucht das Mikrofon für Videos mit Ton."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Reelive hängt Ort und Zeit an deine Momente, damit der Recap sie einordnen kann."
        }
      ],
      "expo-video",
      "expo-notifications",
      [
        "expo-media-library",
        {
          "photosPermission": "Reelive braucht Zugriff auf deine Fotobibliothek, um Momente aus dem Recap dort zu sichern.",
          "savePhotosPermission": "Reelive speichert Momente aus dem Recap in deiner Fotobibliothek.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo",
            "video"
          ]
        }
      ],
      "react-native-maps",
      "@sentry/react-native",
      "./plugins/withSceneLifecycle",
      "./plugins/withPushEntitlement",
      "./plugins/withSentryOhneUpload",
      "./plugins/withAppleTeam"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
