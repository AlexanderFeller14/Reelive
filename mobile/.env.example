# LAN-IP des Dev-Macs (ifconfig | grep "inet "), funktioniert für Simulator,
# Android-Emulator UND echte Geräte im gleichen WLAN.
# Nur-Simulator-Alternative: http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_URL=http://192.168.1.10:54321
# Aus `supabase status` kopieren (Feld ANON_KEY)
EXPO_PUBLIC_SUPABASE_ANON_KEY=ersetzen
# Login-Provider-Flags (Phase 2: aus)
EXPO_PUBLIC_AUTH_APPLE=false
EXPO_PUBLIC_AUTH_GOOGLE=false

# Die Edge Function supabase/functions/media-urls braucht KEINE Client-Variable
# hier, sie liest ihre S3-Zugangsdaten server-seitig aus eigenen Secrets
# (S3_ENDPOINT, S3_REGION, S3_BUCKET, S3_ACCESS_KEY, S3_SECRET_KEY), z.B. via
# `supabase functions serve --env-file ...` lokal bzw. `supabase secrets set`
# deployed. Der Client kennt diese Werte nie, nur die presigned URLs, die die
# Function zurückgibt.

# Basis des öffentlichen Web-Players, MUSS mit TEILEN_BASIS_URL der Function
# share-link übereinstimmen (supabase/functions/.env.example). Kein
# Sicherheitswert (der Token im Link ist die Berechtigung, nicht die Basis-URL):
# `share-link`, Aktion 'erstellen', liefert die fertige `url` ohnehin selbst
# in ihrer Antwort mit. Die App braucht diese Variable NUR, um den Link eines
# BEREITS bestehenden Teilen-Links erneut anzuzeigen (share_links wird für die
# Owner-Person direkt gelesen, Policy share_links_select_owner, dabei steht
# nur der Token in der Zeile, keine fertige URL). Ohne diese Variable zeigt
# «Recap teilen» für einen bestehenden Link eine Konfigurationsmeldung statt
# eines falschen Links.
EXPO_PUBLIC_TEILEN_BASIS_URL=http://127.0.0.1:8081

# Fehler-Meldung (Task 10, Phase 6, mobile/src/lib/fehlermelder.ts). Aus einem
# Sentry-Projekt kopieren (Settings -> Client Keys (DSN)), ein Projekt und
# damit dieser Wert existieren erst, sobald ein Sentry-Konto angelegt ist
# (Spec §2, "braucht ein fremdes Konto"). UNGESETZT LASSEN ist der normale
# Zustand in der Entwicklung: initFehlermelder() wird dann zu einem
# vollständigen No-Op (kein Sentry.init(), kein Netzwerkaufruf, keine
# Konsolen-Warnung, Versprechen W10). Erst mit einem echten DSN sendet die
# App überhaupt etwas an Sentry.
EXPO_PUBLIC_SENTRY_DSN=
